{
  "name": "cloud-file-manager-root",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Cloud Storage System - Fullstack React + Node.js",
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "start": "npm run start --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspaces",
    "worker": "npm run worker --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:status": "npm run db:status --workspace backend",
    "lint": "eslint ."
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  }
}
