{
  "name": "cloud-file-manager",
  "version": "1.0.0",
  "description": "Personal Cloud File Manager Backend built with Express, MySQL, Sequelize, and AWS S3",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/worker.js",
    "test": "node --test",
    "db:migrate": "node scripts/migrate.js up",
    "db:status": "node scripts/migrate.js status"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "sequelize",
    "aws-s3",
    "jwt",
    "cloud-storage"
  ],
  "author": "Nguyen Van Manh",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "mysql2": "^3.11.5",
    "sequelize": "^6.37.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "private": true
}
