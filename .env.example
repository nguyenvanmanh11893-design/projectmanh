NODE_ENV=development
PORT=3000

# Database Configuration (XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloud_file_manager
DB_USER=root
DB_PASSWORD=

# JWT Authentication (required in production; use a unique secret supplied outside source control)
JWT_SECRET=replace_with_a_unique_secret
JWT_EXPIRES_IN=1d

# AWS S3 Configuration (credentials come from the AWS SDK default provider chain, e.g. an IAM role)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your_s3_bucket_name
