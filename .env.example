NODE_ENV=development
PORT=3000

# Database Configuration (XAMPP MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cloud_file_manager
DB_USER=root
DB_PASSWORD=

# Server-side session authentication
# Browser origin allowed to send credentialed requests (required in production)
APP_ORIGIN=http://localhost:3000
# 1-30 days; sessions are revoked on logout and password changes
SESSION_TTL_DAYS=7
# Set true only when the production TLS proxy is trusted
TRUST_PROXY=false

# Upload-session reservation lifetime (1-60 minutes). It remains longer than a POST authorization so an interrupted browser can request another POST for the same session.
UPLOAD_SESSION_TTL_MINUTES=15
# Direct-upload authorization is deliberately short-lived (1-300 seconds; default 300).
UPLOAD_POST_TTL_SECONDS=300

# Durable RDS worker. The worker is a separate process from the API.
WORKER_POLL_MS=1000
WORKER_SHUTDOWN_MS=25000
# Lease renewal is fenced by a random token; this must exceed normal DB latency.
WORKER_LEASE_MS=60000

# AWS S3 Configuration (credentials come from the AWS SDK default provider chain, e.g. an IAM role)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=your_s3_bucket_name
